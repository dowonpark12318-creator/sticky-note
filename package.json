{
  "name": "corner-note",
  "version": "1.6.0",
  "private": true,
  "description": "An always-on-top Windows note that folds into a screen corner.",
  "author": "dowonpark12318-creator",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "scripts": {
    "setup": "install-electron",
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "test:ui": "node scripts/test-ui.cjs",
    "test:features": "node scripts/test-features.cjs",
    "test:desktop": "node scripts/test-desktop.cjs",
    "icons": "node scripts/generate-icons.cjs",
    "pack:win": "node scripts/package-windows.cjs",
    "test:locales": "node scripts/test-locales.cjs",
    "pack:msix": "node scripts/package-msix.cjs --store",
    "pack:msix:dev": "node scripts/package-msix.cjs --development",
    "store:screenshots": "node scripts/capture-store-screenshots.cjs",
    "store:materials": "node scripts/package-store-materials.cjs",
    "store:check": "node scripts/package-store-materials.cjs --check-text"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.9.0",
    "playwright": "1.64.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
